{
  "schema_version": 1,
  "engines": [
    {
      "language": "typescript",
      "image": "a2dlc-engine-ts:0.1",
      "paths": [
        "src/**/*.ts"
      ],
      "budget": {
        "examples": 2000,
        "seed": 42
      }
    }
  ],
  "agent_hook": {
    "max_blocks": 4
  },
  "checks": [
    {"id": "tsc", "image": "a2dlc-check-tsc:entropos", "command": "sh /check.sh",
     "severity": "blocking", "matches": ["**/*.ts", "**/*.tsx"], "timeout_s": 300}
  ]
}
