{
  "name": "@falsable/entropos",
  "version": "0.1.0",
  "description": "Complexity Router & MCP Gateway with Shannon entropy probe and Beta-Bernoulli Thompson Sampling",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/falsable/Entropos.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "docs/assets",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "bin": {
    "entropos": "./bin/entropos.js"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}